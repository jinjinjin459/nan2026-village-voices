{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nan2026-village-voices-api",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://jinjinjin459.github.io"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
